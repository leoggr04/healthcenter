{% if full %}
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h4>Rechtliches</h4>
        <div class="footer-links">
          <a href="/impressum.html">Impressum</a>
          <a href="/datenschutz.html">Datenschutz</a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Kontakt</h4>
        <div class="footer-contact">
          <span class="contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:{{ settings.contact.phoneHref }}">{{ settings.contact.phone }}</a>
          </span>
          <span class="contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{{ settings.contact.address }}</span>
          </span>
          <span class="contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            <a href="mailto:{{ settings.contact.email }}">{{ settings.contact.email }}</a>
          </span>
        </div>
      </div>
      <div class="footer-col">
        <h4>Spendenkonto</h4>
        <p>{{ settings.bank.recipient }}<br>
        IBAN {{ settings.bank.iban }}<br>
        BIC {{ settings.bank.bic }} &middot; {{ settings.bank.bankName }}</p>
      </div>
    </div>
    <p class="footer-bottom">&copy; <span id="year"></span> {{ settings.footer.copyrightName }}</p>
  </div>
</footer>
{% else %}
<footer class="site-footer">
  <div class="container">
    <p class="footer-bottom">&copy; <span id="year"></span> {{ settings.footer.copyrightName }} &middot; <a href="/impressum.html">Impressum</a> &middot; <a href="/datenschutz.html">Datenschutz</a></p>
  </div>
</footer>
{% endif %}
